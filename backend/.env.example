# PostgreSQL connection string used by Prisma.
# Port 5433 is what docker-compose.yml publishes the database on (5432 is often
# already taken by a local Postgres). Inside Docker the API instead uses db:5432.
DATABASE_URL="postgresql://kanban:kanban@localhost:5433/kanban?schema=public"

# API
PORT=4000

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS: comma-separated list of allowed origins for the frontend
CORS_ORIGIN="http://localhost:3000"
